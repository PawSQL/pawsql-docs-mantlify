{
  "$defs": {
    "Editorial": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "default": "draft",
          "enum": [
            "draft",
            "review",
            "approved",
            "scheduled",
            "published",
            "archived"
          ],
          "title": "Status",
          "type": "string"
        },
        "owners": {
          "items": {
            "type": "string"
          },
          "title": "Owners",
          "type": "array"
        },
        "lastReviewed": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lastreviewed"
        },
        "reviewCycle": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewcycle"
        }
      },
      "title": "Editorial",
      "type": "object"
    },
    "LocalizedText": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "summary": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Summary"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        },
        "keyFeatures": {
          "items": {
            "type": "string"
          },
          "title": "Keyfeatures",
          "type": "array"
        },
        "example": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Example"
        },
        "editorial": {
          "$ref": "#/$defs/Editorial"
        },
        "translation": {
          "anyOf": [
            {
              "$ref": "#/$defs/Translation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "LocalizedText",
      "type": "object"
    },
    "ProductKind": {
      "enum": [
        "optimizer",
        "cloud",
        "advisor",
        "patroller",
        "plan-visualizer",
        "vscode",
        "jetbrains",
        "mcp",
        "community",
        "enterprise"
      ],
      "title": "ProductKind",
      "type": "string"
    },
    "TextBundle": {
      "additionalProperties": false,
      "properties": {
        "zh": {
          "anyOf": [
            {
              "$ref": "#/$defs/LocalizedText"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "en": {
          "anyOf": [
            {
              "$ref": "#/$defs/LocalizedText"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "TextBundle",
      "type": "object"
    },
    "Translation": {
      "additionalProperties": false,
      "properties": {
        "sourceLanguage": {
          "enum": [
            "zh",
            "en"
          ],
          "title": "Sourcelanguage",
          "type": "string"
        },
        "sourceDigest": {
          "title": "Sourcedigest",
          "type": "string"
        }
      },
      "required": [
        "sourceLanguage",
        "sourceDigest"
      ],
      "title": "Translation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Product registry entry under metadata/products (referenced by FeatureManifest.product).",
  "properties": {
    "id": {
      "description": "Product id, e.g. pawsql-optimizer. Referenced by feature manifests.",
      "title": "Id",
      "type": "string"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "kind": {
      "anyOf": [
        {
          "$ref": "#/$defs/ProductKind"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "description": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Description"
    },
    "tags": {
      "items": {
        "type": "string"
      },
      "title": "Tags",
      "type": "array"
    },
    "content": {
      "$ref": "#/$defs/TextBundle"
    }
  },
  "required": [
    "id",
    "name"
  ],
  "title": "ProductMetadata",
  "type": "object"
}
