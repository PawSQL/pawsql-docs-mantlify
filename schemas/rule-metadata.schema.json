{
  "$defs": {
    "Severity": {
      "enum": [
        "error",
        "warning",
        "info"
      ],
      "title": "Severity",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "One audit or optimizer rule (design 8.2). Used to generate rule reference pages.",
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "category": {
      "description": "Rule category, e.g. index / select / join / ddl.",
      "title": "Category",
      "type": "string"
    },
    "severity": {
      "$ref": "#/$defs/Severity",
      "default": "warning"
    },
    "database": {
      "items": {
        "type": "string"
      },
      "title": "Database",
      "type": "array"
    },
    "introducedVersion": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Introducedversion"
    },
    "deprecatedVersion": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Deprecatedversion"
    },
    "implementationClass": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Implementationclass"
    },
    "description": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Description"
    },
    "badExample": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Badexample"
    },
    "goodExample": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Goodexample"
    },
    "whyItMatters": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Whyitmatters"
    },
    "howToFix": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Howtofix"
    },
    "relatedRules": {
      "items": {
        "type": "string"
      },
      "title": "Relatedrules",
      "type": "array"
    },
    "tags": {
      "items": {
        "type": "string"
      },
      "title": "Tags",
      "type": "array"
    }
  },
  "required": [
    "id",
    "name",
    "category"
  ],
  "title": "RuleMetadata",
  "type": "object"
}
