{
  "$defs": {
    "RuleCategory": {
      "description": "Controlled vocabulary for rule categories (decided 2026-09-04, A3).\n\n``unknown`` is a temporary placeholder for rules awaiting product mapping;\nsuch rules must not be considered published.",
      "enum": [
        "ddl",
        "dml",
        "index",
        "rewrite",
        "join",
        "subquery",
        "null",
        "union",
        "predicate",
        "constant",
        "unknown"
      ],
      "title": "RuleCategory",
      "type": "string"
    },
    "RuleContent": {
      "additionalProperties": false,
      "description": "Language-specific rule prose (title + sections + examples).\n\nNeutral facts (id/category/severity/database/versions) stay on the\nRuleMetadata root; everything that reads as \"language\" lives here.",
      "properties": {
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "summary": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Human one-liner for page front-matter description (SEO, <= ~155 chars).",
          "title": "Summary"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "whyItMatters": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Whyitmatters"
        },
        "howToFix": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Howtofix"
        },
        "badExample": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Badexample"
        },
        "goodExample": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Goodexample"
        }
      },
      "title": "RuleContent",
      "type": "object"
    },
    "RuleContentBundle": {
      "additionalProperties": false,
      "description": "The two language slots of a rule's content (zh default + en mirror).",
      "properties": {
        "zh": {
          "anyOf": [
            {
              "$ref": "#/$defs/RuleContent"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "en": {
          "anyOf": [
            {
              "$ref": "#/$defs/RuleContent"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "RuleContentBundle",
      "type": "object"
    },
    "Severity": {
      "enum": [
        "error",
        "warning",
        "info"
      ],
      "title": "Severity",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "One audit or optimizer rule (design 8.2). Used to generate rule reference pages.\n\nRoot fields are language-neutral facts. Prose lives under ``content`` with\nper-language slots; the zh-default site generates the zh page at the content\nroot from ``content.zh`` and the en mirror under ``docs/en`` from\n``content.en``. Legacy files that kept English prose on the root plus an\noptional ``zh`` block are migrated on read (see model_validator below).",
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "category": {
      "$ref": "#/$defs/RuleCategory",
      "default": "unknown"
    },
    "severity": {
      "$ref": "#/$defs/Severity",
      "default": "warning"
    },
    "database": {
      "items": {
        "type": "string"
      },
      "title": "Database",
      "type": "array"
    },
    "introducedVersion": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Introducedversion"
    },
    "deprecatedVersion": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Deprecatedversion"
    },
    "implementationClass": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Implementationclass"
    },
    "relatedRules": {
      "items": {
        "type": "string"
      },
      "title": "Relatedrules",
      "type": "array"
    },
    "tags": {
      "items": {
        "type": "string"
      },
      "title": "Tags",
      "type": "array"
    },
    "content": {
      "$ref": "#/$defs/RuleContentBundle",
      "description": "Per-language prose: content.en (mirror) and content.zh (default)."
    }
  },
  "required": [
    "id"
  ],
  "title": "RuleMetadata",
  "type": "object"
}
