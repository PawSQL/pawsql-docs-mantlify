{
  "$defs": {
    "DocStatus": {
      "enum": [
        "draft",
        "review",
        "approved",
        "scheduled",
        "published",
        "archived"
      ],
      "title": "DocStatus",
      "type": "string"
    },
    "DocType": {
      "enum": [
        "explanation",
        "guide",
        "use-case",
        "support",
        "article",
        "product",
        "user-guide",
        "tutorial",
        "reference",
        "faq",
        "troubleshooting",
        "release-note",
        "blog"
      ],
      "title": "DocType",
      "type": "string"
    }
  },
  "additionalProperties": true,
  "description": "Compatibility schema; frontmatter-v2.schema.json defines canonical documents.",
  "properties": {
    "id": {
      "description": "Stable unique id of the page (URL-safe slug).",
      "title": "Id",
      "type": "string"
    },
    "title": {
      "description": "Page title.",
      "title": "Title",
      "type": "string"
    },
    "description": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "One-line summary; also used for AI retrieval quality.",
      "title": "Description"
    },
    "type": {
      "$ref": "#/$defs/DocType",
      "description": "Document type (design 7.2)."
    },
    "product": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Product id this page belongs to.",
      "title": "Product"
    },
    "versionIntroduced": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Versionintroduced"
    },
    "status": {
      "$ref": "#/$defs/DocStatus",
      "default": "draft"
    },
    "tags": {
      "items": {
        "type": "string"
      },
      "title": "Tags",
      "type": "array"
    },
    "owners": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Owners"
    },
    "lastReviewed": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Lastreviewed"
    },
    "reviewCycle": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Review interval in days.",
      "title": "Reviewcycle"
    },
    "relatedFeatures": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Feature ids (Feature Manifest) this page documents.",
      "title": "Relatedfeatures"
    },
    "localeOf": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Mirror pairing: id of the counterpart page in the other language.",
      "title": "Localeof"
    },
    "category": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Controlled vocabulary token (rules/config pages); see docs/contributing/frontmatter.md.",
      "title": "Category"
    },
    "subtype": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Subtype"
    },
    "layout": {
      "default": "detail",
      "enum": [
        "detail",
        "index"
      ],
      "title": "Layout",
      "type": "string"
    },
    "language": {
      "anyOf": [
        {
          "enum": [
            "zh",
            "en"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Language"
    },
    "translationKey": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Translationkey"
    },
    "components": {
      "items": {
        "type": "string"
      },
      "title": "Components",
      "type": "array"
    },
    "capabilities": {
      "items": {
        "type": "string"
      },
      "title": "Capabilities",
      "type": "array"
    },
    "editions": {
      "items": {
        "type": "string"
      },
      "title": "Editions",
      "type": "array"
    },
    "deployments": {
      "items": {
        "type": "string"
      },
      "title": "Deployments",
      "type": "array"
    },
    "interfaces": {
      "items": {
        "type": "string"
      },
      "title": "Interfaces",
      "type": "array"
    },
    "integrations": {
      "items": {
        "type": "string"
      },
      "title": "Integrations",
      "type": "array"
    },
    "audience": {
      "items": {
        "type": "string"
      },
      "title": "Audience",
      "type": "array"
    },
    "entityRef": {
      "anyOf": [
        {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Entityref"
    },
    "relations": {
      "items": {
        "additionalProperties": {
          "type": "string"
        },
        "type": "object"
      },
      "title": "Relations",
      "type": "array"
    },
    "sections": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Sections",
      "type": "object"
    }
  },
  "required": [
    "id",
    "title",
    "type"
  ],
  "title": "FrontMatter",
  "type": "object"
}
