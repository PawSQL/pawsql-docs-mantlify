{
  "$defs": {
    "Compatibility": {
      "additionalProperties": false,
      "properties": {
        "databaseVersions": {
          "items": {
            "type": "string"
          },
          "title": "Databaseversions",
          "type": "array"
        },
        "product": {
          "const": "pawsql",
          "default": "pawsql",
          "title": "Product",
          "type": "string"
        },
        "component": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Component"
        },
        "productVersionRange": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Productversionrange"
        },
        "capability": {
          "title": "Capability",
          "type": "string"
        },
        "status": {
          "default": "unknown",
          "enum": [
            "supported",
            "partial",
            "unsupported",
            "unknown"
          ],
          "title": "Status",
          "type": "string"
        },
        "limitations": {
          "items": {
            "$ref": "#/$defs/Condition"
          },
          "title": "Limitations",
          "type": "array"
        },
        "evidenceIds": {
          "items": {
            "type": "string"
          },
          "title": "Evidenceids",
          "type": "array"
        }
      },
      "required": [
        "databaseVersions",
        "capability"
      ],
      "title": "Compatibility",
      "type": "object"
    },
    "Condition": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "content": {
          "additionalProperties": {
            "type": "string"
          },
          "propertyNames": {
            "enum": [
              "zh",
              "en"
            ]
          },
          "title": "Content",
          "type": "object"
        }
      },
      "required": [
        "code"
      ],
      "title": "Condition",
      "type": "object"
    },
    "Editorial": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "default": "draft",
          "enum": [
            "draft",
            "review",
            "approved",
            "scheduled",
            "published",
            "archived"
          ],
          "title": "Status",
          "type": "string"
        },
        "owners": {
          "items": {
            "type": "string"
          },
          "title": "Owners",
          "type": "array"
        },
        "lastReviewed": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lastreviewed"
        },
        "reviewCycle": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reviewcycle"
        }
      },
      "title": "Editorial",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "supports": {
          "items": {
            "type": "string"
          },
          "title": "Supports",
          "type": "array"
        },
        "status": {
          "default": "pending",
          "enum": [
            "pending",
            "verified",
            "rejected"
          ],
          "title": "Status",
          "type": "string"
        },
        "verifiedBy": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Verifiedby"
        },
        "verifiedAt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Verifiedat"
        }
      },
      "required": [
        "id",
        "source"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "LocalizedText": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "summary": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Summary"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "notes": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notes"
        },
        "keyFeatures": {
          "items": {
            "type": "string"
          },
          "title": "Keyfeatures",
          "type": "array"
        },
        "example": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Example"
        },
        "editorial": {
          "$ref": "#/$defs/Editorial"
        },
        "translation": {
          "anyOf": [
            {
              "$ref": "#/$defs/Translation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "LocalizedText",
      "type": "object"
    },
    "Source": {
      "additionalProperties": false,
      "properties": {
        "repository": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Repository"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Revision"
        },
        "url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        }
      },
      "title": "Source",
      "type": "object"
    },
    "TextBundle": {
      "additionalProperties": false,
      "properties": {
        "zh": {
          "anyOf": [
            {
              "$ref": "#/$defs/LocalizedText"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "en": {
          "anyOf": [
            {
              "$ref": "#/$defs/LocalizedText"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "title": "TextBundle",
      "type": "object"
    },
    "Translation": {
      "additionalProperties": false,
      "properties": {
        "sourceLanguage": {
          "enum": [
            "zh",
            "en"
          ],
          "title": "Sourcelanguage",
          "type": "string"
        },
        "sourceDigest": {
          "title": "Sourcedigest",
          "type": "string"
        }
      },
      "required": [
        "sourceLanguage",
        "sourceDigest"
      ],
      "title": "Translation",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Supported database versions and capability matrix (design 8.3).",
  "properties": {
    "database": {
      "description": "Database slug, e.g. postgresql.",
      "title": "Database",
      "type": "string"
    },
    "title": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Display name, e.g. PostgreSQL.",
      "title": "Title"
    },
    "supportedVersions": {
      "items": {
        "type": "string"
      },
      "title": "Supportedversions",
      "type": "array"
    },
    "features": {
      "additionalProperties": {
        "type": "boolean"
      },
      "description": "Capability flags, e.g. {optimizer: true, audit: true, planVisualizer: false}.",
      "title": "Features",
      "type": "object"
    },
    "capabilities": {
      "additionalProperties": {
        "enum": [
          "supported",
          "partial",
          "unsupported"
        ],
        "type": "string"
      },
      "description": "Per-database support status keyed by capability slug.",
      "title": "Capabilities",
      "type": "object"
    },
    "description": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Description"
    },
    "keyFeatures": {
      "items": {
        "type": "string"
      },
      "title": "Keyfeatures",
      "type": "array"
    },
    "notes": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Notes"
    },
    "content": {
      "$ref": "#/$defs/TextBundle"
    },
    "compatibility": {
      "items": {
        "$ref": "#/$defs/Compatibility"
      },
      "title": "Compatibility",
      "type": "array"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Evidence"
      },
      "title": "Evidence",
      "type": "array"
    }
  },
  "required": [
    "database"
  ],
  "title": "DatabaseMetadata",
  "type": "object"
}
